diff --git a/Source/ui_libretro/PlayJitMemory.h b/Source/ui_libretro/PlayJitMemory.h
new file mode 100644
index 0000000..93b7604
--- /dev/null
+++ b/Source/ui_libretro/PlayJitMemory.h
@@ -0,0 +1,75 @@
+#pragma once
+
+#include <algorithm>
+#include "ext/libretro.h"
+#include "MemoryFunction.h"
+
+// Executable-memory ABI from RetroArch's libretro.h, version 1.
+#ifndef RETRO_ENVIRONMENT_EXEC_MEM_ALLOC
+#define RETRO_ENVIRONMENT_EXEC_MEM_ALLOC 83
+#define RETRO_ENVIRONMENT_EXEC_MEM_FREE 84
+#define RETRO_EXEC_MEM_MODE_UNAVAILABLE 0
+#define RETRO_EXEC_MEM_MODE_UNRESTRICTED 1
+#define RETRO_EXEC_MEM_MODE_RWX 2
+#define RETRO_EXEC_MEM_MODE_WX_TOGGLE 3
+#define RETRO_EXEC_MEM_MODE_DUAL_MAP 4
+struct retro_exec_mem_alloc
+{
+	unsigned version;
+	size_t size;
+	unsigned mode;
+	void* rx;
+	void* rw;
+};
+struct retro_exec_mem_free { void* rx; };
+#endif
+
+class CPlayJitMemory
+{
+public:
+	bool Prepare(retro_environment_t environment)
+	{
+		if(m_rx) return true;
+		retro_exec_mem_alloc probe = {1, 0, RETRO_EXEC_MEM_MODE_UNAVAILABLE, nullptr, nullptr};
+		if(environment(RETRO_ENVIRONMENT_EXEC_MEM_ALLOC, &probe))
+		{
+			if(probe.mode == RETRO_EXEC_MEM_MODE_DUAL_MAP || probe.mode == RETRO_EXEC_MEM_MODE_RWX)
+			{
+				size_t size = 256 * 1024 * 1024;
+				if(probe.size) size = std::min(size, probe.size);
+				retro_exec_mem_alloc allocation = {1, size, RETRO_EXEC_MEM_MODE_UNAVAILABLE, nullptr, nullptr};
+				if(!environment(RETRO_ENVIRONMENT_EXEC_MEM_ALLOC, &allocation)) return false;
+				if(!allocation.rx || !allocation.rw || allocation.size < size ||
+				   (allocation.mode != RETRO_EXEC_MEM_MODE_DUAL_MAP && allocation.mode != RETRO_EXEC_MEM_MODE_RWX) ||
+				   !CMemoryFunction::SetExternalMemory(allocation.rx, allocation.rw, allocation.size))
+				{
+					if(allocation.rx)
+					{
+						retro_exec_mem_free release = {allocation.rx};
+						environment(RETRO_ENVIRONMENT_EXEC_MEM_FREE, &release);
+					}
+					return false;
+				}
+				m_rx = allocation.rx;
+				return true;
+			}
+			if(probe.mode != RETRO_EXEC_MEM_MODE_WX_TOGGLE && probe.mode != RETRO_EXEC_MEM_MODE_UNRESTRICTED)
+				return false;
+		}
+		bool canJit = false;
+		return environment(RETRO_ENVIRONMENT_GET_JIT_CAPABLE, &canJit) && canJit;
+	}
+
+	void Release(retro_environment_t environment)
+	{
+		if(m_rx && CMemoryFunction::SetExternalMemory(nullptr, nullptr, 0))
+		{
+			retro_exec_mem_free release = {m_rx};
+			environment(RETRO_ENVIRONMENT_EXEC_MEM_FREE, &release);
+			m_rx = nullptr;
+		}
+	}
+
+private:
+	void* m_rx = nullptr;
+};

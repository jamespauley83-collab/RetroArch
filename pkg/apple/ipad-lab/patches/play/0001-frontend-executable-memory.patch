 #define BLOCK_ALIGN 0x10
 
+namespace
+{
+	std::mutex arenaMutex;
+	uint8* arenaRx = nullptr;
+	uint8* arenaRw = nullptr;
+	size_t arenaLive = 0;
+	std::map<size_t, size_t> arenaFree;
+}
+
+bool CMemoryFunction::SetExternalMemory(void* rx, void* rw, size_t size)
+{
+	std::lock_guard<std::mutex> lock(arenaMutex);
+	if(arenaLive) return false;
+	if((rx || rw || size) && (!rx || !rw || !size ||
+	   (reinterpret_cast<uintptr_t>(rx) % BLOCK_ALIGN) ||
+	   (reinterpret_cast<uintptr_t>(rw) % BLOCK_ALIGN) || (size % BLOCK_ALIGN))) return false;
+	arenaFree.clear();
+	if(size) arenaFree.emplace(0, size);
+	arenaRx = static_cast<uint8*>(rx);
+	arenaRw = static_cast<uint8*>(rw);
+	return true;
+}
+

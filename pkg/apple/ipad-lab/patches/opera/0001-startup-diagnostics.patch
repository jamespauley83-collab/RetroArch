diff --git a/opera_lab.h b/opera_lab.h
new file mode 100644
index 0000000..992f319
--- /dev/null
+++ b/opera_lab.h
@@ -0,0 +1,36 @@
+#ifndef OPERA_LAB_H_INCLUDED
+#define OPERA_LAB_H_INCLUDED
+
+#include "opera_lr_callbacks.h"
+#include <file/file_path.h>
+#include <retro_miscellaneous.h>
+#include <stdarg.h>
+#include <stdio.h>
+
+static void
+opera_lab_log(const char *format, ...)
+{
+  const char *directory = NULL;
+  char path[PATH_MAX_LENGTH];
+  char message[2048];
+  FILE *file;
+  va_list args;
+
+  va_start(args,format);
+  vsnprintf(message,sizeof(message),format,args);
+  va_end(args);
+  if(retro_log_printf_cb)
+    retro_log_printf_cb(RETRO_LOG_INFO,"[Opera Lab] %s\n",message);
+  if(!retro_environment_cb ||
+     !retro_environment_cb(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY,&directory) ||
+     !directory || !directory[0])
+    return;
+  fill_pathname_join(path,directory,"opera-lab-diagnostic.log",sizeof(path));
+  file = fopen(path,"a");
+  if(!file)
+    return;
+  fprintf(file,"[Opera Lab] %s\n",message);
+  fclose(file);
+}
+
+#endif

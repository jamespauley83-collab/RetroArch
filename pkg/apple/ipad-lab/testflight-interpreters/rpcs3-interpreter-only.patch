@@ -0,0 +1,116 @@
+#include "JITIOS.h"
+
+#if !defined(RPCS3_IOS) || !defined(RPCS3_IOS_JITLESS_ONLY)
+#error "JITIOSInterpreter.cpp requires the interpreter-only Apple mobile build"
+#endif
+
+#include <atomic>
+
+namespace
+{
+std::atomic_bool g_sealed{false};
+}
+
+namespace rpcs3::ios::jit
+{
+memory_mode selected_memory_mode() noexcept
+{
+	return memory_mode::arena;
+}
+
+bool uses_regular_memory() noexcept
+{
+	return false;
+}
+
+regular_allocator::~regular_allocator()
+{
+	(void)m_group;
+}
+
+void* regular_allocator::allocate(bool, usz, usz) noexcept
+{
+	return nullptr;
+}
+
+bool is_jitless() noexcept
+{
+	return true;
+}
+
+bool is_ready() noexcept
+{
+	return false;
+}
+
+bool prepare_arena() noexcept
+{
+	return true;
+}
+
+bool prepare_arena(u32) noexcept
+{
+	return true;
+}
+
+bool seal_arena() noexcept
+{
+	g_sealed.store(true, std::memory_order_relaxed);
+	return true;
+}
+
+void* runtime_memory(bool) noexcept
+{
+	return nullptr;
+}
+
+usz arena_capacity(bool) noexcept
+{
+	return 0;
+}
+
+bool claim_runtime(bool, usz, usz size) noexcept
+{
+	return size == 0;
+}
+
+void reset_runtime() noexcept
+{
+}
+
+void* allocate(bool, usz, usz) noexcept
+{
+	return nullptr;
+}
+
+void release_allocation(bool, void*, usz) noexcept
+{
+}
+
+void* writable(const void*, usz) noexcept
+{
+	return nullptr;
+}
+
+void flush(const void*, usz) noexcept
+{
+}
+
+arena_statistics get_statistics() noexcept
+{
+	arena_statistics result;
+	result.backend = arena_backend::disabled;
+	result.sealed = g_sealed.load(std::memory_order_relaxed);
+	return result;
+}
+
+std::string no_footprint_diagnostics()
+{
+	return {};
+}
+
+const char* last_error() noexcept
+{
+	return "RPCS3 interpreter-only distribution does not allocate executable memory";
+}
+}

--- a/pcsx2-libretro/CMakeLists.txt
+++ b/pcsx2-libretro/CMakeLists.txt
@@ -46,6 +46,14 @@
 add_custom_target(armsx2_libretro)
 add_dependencies(armsx2_libretro pcsx2-libretro)
 
+option(RETROARCH_LAB_ARMSX2_NO_JIT "Run the Lab core using existing interpreter providers only" OFF)
+if(RETROARCH_LAB_ARMSX2_NO_JIT)
+    if(NOT IOS OR NOT RETROARCH_LAB_ARMSX2_BRIDGE OR RETROARCH_LAB_ARMSX2_BUILD_PROBE)
+        message(FATAL_ERROR "Interpreter distribution requires the iOS Lab bridge and no build-probe gate")
+    endif()
+    target_compile_definitions(pcsx2-libretro PRIVATE RETROARCH_LAB_ARMSX2_NO_JIT=1)
+endif()
+
 if(RETROARCH_LAB_ARMSX2_DEVICE_TEST)
     if(RETROARCH_LAB_ARMSX2_BUILD_PROBE OR NOT RETROARCH_LAB_ARMSX2_BRIDGE)
         message(FATAL_ERROR "Device testing requires the bridge and must not enable the build-probe gate")

+bool available_capacity_for_import(const std::string& path, std::uint64_t& capacity) noexcept
+{
+	@autoreleasepool
+	{
+		NSURL* url = [NSURL fileURLWithFileSystemRepresentation:path.c_str()
+			isDirectory:YES relativeToURL:nil];
+		NSNumber* value = nil;
+		if (![url getResourceValue:&value
+			forKey:NSURLVolumeAvailableCapacityForImportantUsageKey error:nil] ||
+			![value isKindOfClass:NSNumber.class] || value.longLongValue < 0)
+		{
+			return false;
+		}
+		capacity = static_cast<std::uint64_t>(value.longLongValue);
+		return true;
+	}
+}

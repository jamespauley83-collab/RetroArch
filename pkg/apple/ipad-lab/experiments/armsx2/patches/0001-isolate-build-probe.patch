diff --git a/pcsx2-libretro/LabPrototypeGate.h b/pcsx2-libretro/LabPrototypeGate.h
new file mode 100644
index 0000000..57101cb
--- /dev/null
+++ b/pcsx2-libretro/LabPrototypeGate.h
@@ -0,0 +1,14 @@
+#pragma once
+#include "libretro.h"
+
+inline bool LabPrototypeCanLoad(retro_environment_t environment, retro_log_printf_t log)
+{
+    const char* message = "ARMSX2 Lab build probe: gameplay disabled until graphics and JIT integration are validated.";
+    if(log) log(RETRO_LOG_ERROR, "%s\n", message);
+    if(environment)
+    {
+        retro_message notification = {message, 300};
+        environment(RETRO_ENVIRONMENT_SET_MESSAGE, &notification);
+    }
+    return false;
+}

diff --git a/common/LabFrontend.h b/common/LabFrontend.h
new file mode 100644
index 0000000..b4276f3
--- /dev/null
+++ b/common/LabFrontend.h
@@ -0,0 +1,121 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+#include <utility>
+#include <vector>
+
+namespace LabFrontend
+{
+// RetroArch executable-memory ABI v1. No WX-toggle: EE/VU writes can overlap.
+using Environment = bool (*)(unsigned, void*);
+struct Allocation
+{
+	unsigned version;
+	size_t size;
+	unsigned mode;
+	void* rx;
+	void* rw;
+};
+struct ReleaseRequest { void* rx; };
+class CodeArena
+{
+public:
+	bool Prepare(Environment environment, size_t size)
+	{
+		if (m_allocation.rx) return size <= m_allocation.size;
+		if (!environment || !size) return false;
+		Allocation probe{1, 0, 0, nullptr, nullptr};
+		if (!environment(83, &probe) || (probe.mode != 2 && probe.mode != 4) ||
+			(probe.size && probe.size < size)) return false;
+		Allocation allocation{1, size, 0, nullptr, nullptr};
+		const bool allocated = environment(83, &allocation);
+		const uintptr_t rx = reinterpret_cast<uintptr_t>(allocation.rx);
+		const uintptr_t rw = reinterpret_cast<uintptr_t>(allocation.rw);
+		const uintptr_t distance = rx > rw ? rx - rw : rw - rx;
+		if (!allocated || !rx || !rw || allocation.size < size ||
+			(allocation.mode != 2 && allocation.mode != 4) ||
+			(allocation.mode == 2 && rx != rw) ||
+			(allocation.mode == 4 && rx == rw) ||
+			(rx % 16384) || (rw % 16384) ||
+			distance > static_cast<uintptr_t>(std::numeric_limits<ptrdiff_t>::max()))
+		{
+			if (allocation.rx) { ReleaseRequest release{allocation.rx}; environment(84, &release); }
+			return false;
+		}
+		m_environment = environment;
+		m_allocation = allocation;
+		return true;
+	}
+	void Release()
+	{
+		if (!m_allocation.rx) return;
+		ReleaseRequest release{m_allocation.rx};
+		m_environment(84, &release);
+		m_allocation = {};
+		m_environment = nullptr;
+	}
+	void* RX(size_t size) const { return size <= m_allocation.size ? m_allocation.rx : nullptr; }
+	void* WritableForRX(void* address, size_t size) const
+	{
+		const uintptr_t base = reinterpret_cast<uintptr_t>(m_allocation.rx);
+		const uintptr_t pointer = reinterpret_cast<uintptr_t>(address);
+		if (!base || pointer < base || pointer - base > m_allocation.size ||
+			size > m_allocation.size - (pointer - base)) return nullptr;
+		return static_cast<unsigned char*>(m_allocation.rw) + (pointer - base);
+	}
+	void* RW() const { return m_allocation.rw; }
+	bool Ready() const { return m_allocation.rx != nullptr; }
+	ptrdiff_t Offset() const
+	{
+		const uintptr_t rx = reinterpret_cast<uintptr_t>(m_allocation.rx);
+		const uintptr_t rw = reinterpret_cast<uintptr_t>(m_allocation.rw);
+		return rw >= rx ? static_cast<ptrdiff_t>(rw - rx) : -static_cast<ptrdiff_t>(rx - rw);
+	}
+private:
+	Environment m_environment = nullptr;
+	Allocation m_allocation{};
+};
+inline CodeArena Code;
+
+struct Frame
+{
+	unsigned width = 0, height = 0;
+	std::vector<uint32_t> pixels;
+};
+// One latest frame, so an open frontend menu cannot grow a queue or block MTGS.
+class FrameMailbox
+{
+public:
+	bool Publish(Frame frame)
+	{
+		if (!frame.width || !frame.height || frame.width > 640 || frame.height > 448 ||
+			frame.pixels.size() != static_cast<size_t>(frame.width) * frame.height) return false;
+		// Metal download is RGBA8; libretro XRGB8888 is 0x00RRGGBB.
+		for (auto& pixel : frame.pixels)
+			pixel = ((pixel & 0xff) << 16) | (pixel & 0xff00) | ((pixel >> 16) & 0xff);
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_frame = std::move(frame);
+		return true;
+	}
+	bool Consume(Frame& frame)
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		if (m_frame.pixels.empty()) return false;
+		frame = std::move(m_frame);
+		m_frame = {};
+		return true;
+	}
+	void Clear()
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		m_frame = {};
+	}
+private:
+	std::mutex m_mutex;
+	Frame m_frame;
+};
+inline FrameMailbox Frames;
+}

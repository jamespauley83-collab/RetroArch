+	// Execute through RX, then patch through RW and verify instruction-cache visibility.
+	const uint32_t instructions[] = {0x52800540, 0xd65f03c0}; // mov w0,#42; ret
+	void* executable = LabFrontend::Code.RX(sizeof(instructions));
+	std::memcpy(LabFrontend::Code.RW(), instructions, sizeof(instructions));
+	HostSys::FlushInstructionCache(executable, sizeof(instructions));
+	const auto probe = reinterpret_cast<unsigned (*)()>(executable);
+	const unsigned first = probe();
+	const uint32_t patched = 0x52800560; // mov w0,#43
+	std::memcpy(LabFrontend::Code.RW(), &patched, sizeof(patched));
+	HostSys::FlushInstructionCache(executable, sizeof(instructions));
+	if (first != 42 || probe() != 43)

#include "../GitHubCI.xcconfig"

// The Lab container must also be authorized by the device provisioning profile.
OTHER_CFLAGS = $(inherited) -DHAVE_ICLOUD_DRIVE -DHAVE_RETROARCH_LAB_LIBRARY
OTHER_CFLAGS = $(inherited) -DICLOUD_DRIVE_CONTAINER_NAME=@\"$(LAB_ICLOUD_CONTAINER)\"

// Set only for the optional helper candidate.
OTHER_CFLAGS = $(inherited) $(LAB_JIT_FLAGS)
OTHER_LDFLAGS = $(inherited) -framework Security -framework UniformTypeIdentifiers
